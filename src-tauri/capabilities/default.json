{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "메인 창 권한: 임의 경로 파일 IO(유저 지정 데이터 폴더), 폴더 선택 다이얼로그, 트레이",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:allow-default-window-icon",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "core:tray:default",
    "core:menu:default",
    "dialog:allow-open",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }]
    },
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }, { "path": "$APPCONFIG" }, { "path": "$APPCONFIG/**" }]
    }
  ]
}
